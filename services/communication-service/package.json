    "firebase-admin": "^14.0.0",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.16",
    "postgres": "^3.4.9",
    "redis": "^4.6.10",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.17",
